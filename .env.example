# Development: use the mock provider and console e-mail transport.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/demifietsen"
# Use a non-pooler/direct connection for Prisma migrations when applicable.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/demifietsen"
AUTH_SECRET="replace-with-a-long-random-secret"
IP_HASH_SECRET="replace-with-a-separate-long-random-secret"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
# Permanent host embedded in physical QR labels, including preview-generated PDFs.
PUBLIC_QR_BASE_URL="https://demifietsen.nl"
# SHA-256 signing-certificate fingerprint used by /.well-known/assetlinks.json.
ANDROID_APP_CERT_SHA256=""
DEPLOYMENT_MODE="development"

PAYMENT_PROVIDER="mock"
MOLLIE_API_KEY_TEST=""
MOLLIE_API_KEY=""
ENABLE_MOCK_PAYMENT_WEBHOOK="1"

MEDIA_STORAGE_PATH="./storage/media"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="demifietsen-media"
EMAIL_TRANSPORT="console"
SMTP_URL=""
EMAIL_FROM="Demi Fietsen <noreply@example.test>"
NEWSLETTER_PROVIDER="none"
RESERVATION_TTL_MINUTES="30"
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Firebase Admin (server-side FCM delivery). Keep the private key escaped as
# one line in Render/Vercel: -----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Development seed only. Never use these fallbacks for a production database.
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="replace-this-development-password"
