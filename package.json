{
  "name": "demifietsen-webshop",
  "version": "0.1.0",
  "private": true,
  "description": "Purpose-built webshop and business administration for Demi Fietsen (unique second-hand e-bikes + stocked accessories)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "backup": "node scripts/backup.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@mollie/api-client": "^4.6.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "next": "15.5.24",
    "next-auth": "4.24.15",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
